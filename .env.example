DISCORD_TOKEN=your_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Must be a Flash-family model available on your free tier.
# GEMINI_MODEL=gemini-3.6-flash

# Your Render URL (set after the first deploy so Render knows its own address).
# PUBLIC_URL=https://your-app-name.onrender.com

# Optional tuning
# COOLDOWN_MS=3000
# MAX_HISTORY=24
# ALLOWED_CHANNELS=123456789,987654321
# SYSTEM_PROMPT=
